# Auto detect text files and normalize line endings to LF in repository
* text=auto

# Python source files - always use LF
*.py text eol=lf
*.pyx text eol=lf
*.pyi text eol=lf
*.pyw text eol=lf

# Shell scripts - always use LF
*.sh text eol=lf
*.bash text eol=lf

# Windows batch files - always use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Configuration files - use LF
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf

# Web files - use LF
*.html text eol=lf
*.htm text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.jsx text eol=lf
*.tsx text eol=lf

# Documentation - use LF
*.md text eol=lf
*.txt text eol=lf
*.rst text eol=lf
*.adoc text eol=lf

# Requirements and dependencies
requirements*.txt text eol=lf
*.lock text eol=lf
Pipfile text eol=lf
setup.py text eol=lf
setup.cfg text eol=lf

# Docker files
Dockerfile text eol=lf
docker-compose*.yml text eol=lf
.dockerignore text eol=lf

# Git files
.gitignore text eol=lf
.gitattributes text eol=lf
.gitmodules text eol=lf

# Environment files
.env* text eol=lf

# Binary files - do not normalize
*.pdf binary
*.PDF binary
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.svg binary
*.webp binary
*.pyc binary
*.pyo binary
*.pyd binary
*.so binary
*.dll binary
*.exe binary
*.zip binary
*.tar binary
*.gz binary
*.tgz binary
*.rar binary
*.7z binary
*.whl binary

# Archives
*.db binary
*.sqlite binary
*.sqlite3 binary
*.pkl binary
*.pickle binary

